---
// What each system actually keeps for the bike job: the file, the rows or the datoms, literally,
// with what it's built for, its smallest piece, what one change rewrites and how you'd ask it a
// question. Tabs on the overview; `only` shows one system with no tabs (a product page).
import { STORED, type Stored } from '../../lib/stored';
interface Props { only?: string[] }
const { only } = Astro.props;
const list: Stored[] = only ? STORED.filter((s) => only.includes(s.key)) : STORED;
const tabbed = list.length > 1;
---
<div class="stored" data-stored>
  {tabbed && (
    <div class="st-tabs" role="tablist" aria-label="Systems">
      {list.map((s, i) => <button role="tab" class={`st-tab dm-${s.tint}`} data-st={s.key} aria-selected={i === 0 ? 'true' : 'false'}>{s.name}</button>)}
    </div>
  )}
  {list.map((s, i) => (
    <article class={`st-pane dm-${s.tint}`} data-st-pane={s.key} hidden={tabbed && i > 0}>
      <div class="st-top">
        <div class="st-fact"><span class="st-k">built for</span><p>{s.focus}</p></div>
        <div class="st-fact atom"><span class="st-k">the atom</span><p>{s.atom}</p></div>
      </div>
      <div class="st-blocks">
        {s.blocks.map((b) => (
          <figure class="st-block">
            <figcaption class="st-label">{b.label}</figcaption>
            {b.kind === 'code'
              ? <pre class="st-code" data-lang={b.lang}><code>{b.body}</code></pre>
              : <div class="st-tablewrap"><table class="st-table"><thead><tr>{b.cols.map((c) => <th>{c}</th>)}</tr></thead><tbody>{b.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody></table></div>}
            {b.note && <p class="st-note">{b.note}</p>}
          </figure>
        ))}
      </div>
      <div class="st-bottom">
        <div class="st-fact"><span class="st-k">one change</span><p>{s.write}</p></div>
        <div class="st-fact"><span class="st-k">"Sam's jobs due by Friday?"</span>
          <pre class="st-code ask" data-lang={s.ask.lang}><code>{s.ask.code}</code></pre>
          <p>{s.ask.how}</p>
        </div>
      </div>
    </article>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-stored]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('.st-tab'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('.st-pane'));
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      panes.forEach((p) => (p.hidden = p.dataset.stPane !== t.dataset.st));
    }));
  });
</script>

<style>
  .stored { display: grid; gap: 16px; }
  .st-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .st-tab { font: 500 13px/1 var(--mono); color: var(--ink-2); background: none; border: 1px solid var(--line-strong); border-radius: 999px; padding: 8px 13px; cursor: pointer; }
  .st-tab:hover { color: var(--ink); border-color: var(--sys); }
  .st-tab[aria-selected='true'] { color: var(--ground); background: var(--sys); border-color: var(--sys); }
  .st-pane { display: grid; gap: 16px; padding: 18px; border: 1px solid var(--line); border-top: 3px solid var(--sys); border-radius: 4px; background: color-mix(in srgb, var(--raised) calc(60% - 20% * var(--glow)), transparent); min-width: 0; }
  .st-pane[hidden] { display: none; }
  .st-top, .st-bottom { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 820px) { .st-top { grid-template-columns: 1fr 1fr; } .st-bottom { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); } }
  .st-fact { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .st-fact p { margin: 0; line-height: 1.55; font-size: 15px; color: var(--ink-2); }
  .st-fact.atom { padding: 12px 14px; border-left: 3px solid var(--sys); background: color-mix(in srgb, var(--sys) 9%, transparent); border-radius: 0 3px 3px 0; }
  .st-fact.atom p { color: var(--ink); }
  .st-k { font: 500 10.5px/1.2 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--sys); }
  .st-blocks { display: grid; gap: 14px; }
  .st-block { margin: 0; display: grid; gap: 6px; min-width: 0; }
  .st-label { font: 500 12px/1.3 var(--mono); color: var(--ink-3); }
  .st-code { margin: 0; padding: 14px 16px; overflow-x: auto; border-radius: 4px; border: 1px solid color-mix(in srgb, var(--sys) 40%, var(--line)); background: var(--sunken); font: 12.5px/1.6 var(--mono); color: var(--ink); white-space: pre; tab-size: 4; }
  .st-code.ask { font-size: 12px; }
  .st-tablewrap { overflow-x: auto; border-radius: 4px; border: 1px solid color-mix(in srgb, var(--sys) 40%, var(--line)); background: var(--sunken); }
  .st-table { border-collapse: collapse; font: 12px/1.45 var(--mono); width: 100%; }
  .st-table th { text-align: left; font-weight: 600; color: var(--sys); padding: 8px 12px; border-bottom: 1px solid var(--line-strong); white-space: nowrap; }
  .st-table td { padding: 6px 12px; border-bottom: 1px solid var(--line); vertical-align: top; color: var(--ink); min-width: 4ch; }
  .st-table td:nth-child(n+2) { word-break: break-word; }
  .st-table tr:last-child td { border-bottom: 0; }
  .st-note { margin: 0; font-size: 13.5px; color: var(--ink-3); line-height: 1.5; }
</style>
