---
// The ground under the glass: a dim tile of what fictty is made of (a frame, the JSON behind it,
// box drawing) on the module grid. It's there so the panes have something to refract: through a
// pane it reads softened and tinted. Kept faint enough that text over it holds its contrast.
const L = [
  '╭─ Services ──────────────────────╮',
  '│ api-1    eu-west  112ms ● ok    │',
  '│ api-2    eu-west  948ms ▲ slow  │',
  '│ web      us-east   64ms ● ok    │',
  '╰─────────────────────────────────╯',
  '', '', '', '',
  '                                          {"root": {"type": "row",',
  '                                            "children": [',
  '                                             {"type": "table", "id": "svc",',
  '                                              "bind": "services"}]},',
  '                                           "data": {"services": {',
  '                                             "cmd": ["kubectl", "get", "pods"]}}}',
  '', '', '', '',
  '   ▁▂▃▅▇▆▅▃▂▁▂▄▆█▇▅▃▂▁▁▂▃▅',
  '', '',
  '   $ fictty screen',
  '   │ api-2   948ms  ▲ slow',
  '        ╰─▶ ◆ agent  8× slower',
  '', '', '', '',
  '                                         ████████▌     62%',
  '                                         j/k move · enter logs · q close',
  '', '', '',
];
const LH = 19, W = 760, H = (L.length + 1) * LH;
---
<div class="texture" aria-hidden="true">
  <svg width="100%" height="100%">
    <defs>
      <pattern id="tx-cells" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" class="tx-grid" />
      </pattern>
      <pattern id="tx-frame" width={W} height={H} patternUnits="userSpaceOnUse" x="-12" y="6">
        <text class="tx-text" xml:space="preserve">
          {L.map((l, i) => <tspan x="0" y={(i + 1) * LH}>{l}</tspan>)}
        </text>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#tx-cells)" />
    <rect width="100%" height="100%" fill="url(#tx-frame)" />
  </svg>
</div>
<style>
  .texture { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; contain: strict;
    /* fade at the top and bottom, and quieter under the centre column where the text is */
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 6%, #000 94%, transparent), linear-gradient(90deg, #000, rgba(0,0,0,.28) 30%, rgba(0,0,0,.28) 70%, #000);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(180deg, transparent, #000 6%, #000 94%, transparent), linear-gradient(90deg, #000, rgba(0,0,0,.28) 30%, rgba(0,0,0,.28) 70%, #000);
    mask-composite: intersect; }
  .texture svg { display: block; }
  .tx-grid { stroke: var(--ink-3); stroke-width: 1; opacity: calc(0.05 - 0.015 * var(--glow)); }
  .tx-text { font: 400 12.3px var(--term-font); fill: var(--ink-3); opacity: calc(0.11 - 0.02 * var(--glow)); }
</style>
