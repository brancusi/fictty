---
// A section divider: one letter of the wordmark, its panes sitting on the centre line, with a
// hairline running out to either side. Down the landing page the dividers spell the word.
import { CHOSEN, glassWord, pose } from '../lib/glass';
interface Props { letter: number }
const { letter } = Astro.props;
const scene = glassWord(CHOSEN);
const panes = pose(scene, 9, 0).filter((_, i) => scene[i].li === letter);
const x0 = Math.min(...panes.map((p) => p.x)) - 0.5, y0 = Math.min(...panes.map((p) => p.y)) - 0.5;
const x1 = Math.max(...panes.map((p) => p.x + p.w)) + 0.5, y1 = Math.max(...panes.map((p) => p.y + p.h)) + 0.5;
const n = (v: number) => +v.toFixed(3);
const id = `dv${letter}`;
---
<div class="divider" aria-hidden="true">
  <span class="line l"></span>
  <svg viewBox={`${n(x0)} ${n(y0)} ${n(x1 - x0)} ${n(y1 - y0)}`} style={`width: ${n((x1 - x0) * 9)}px; overflow: visible`}>
    <defs>
      <filter id={`${id}-g`} filterUnits="userSpaceOnUse" x={x0 - 4} y={y0 - 4} width={x1 - x0 + 8} height={y1 - y0 + 8}><feGaussianBlur stdDeviation="0.8" /></filter>
      <linearGradient id={`${id}-c`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color: var(--glass-cyan)" /><stop offset=".5" style="stop-color: var(--glass-violet)" /><stop offset="1" style="stop-color: var(--glass-amber)" /></linearGradient>
    </defs>
    <g filter={`url(#${id}-g)`} style="opacity: calc(var(--glow) * .9); mix-blend-mode: screen">
      {panes.map((p) => <rect x={n(p.x)} y={n(p.y)} width={n(p.w)} height={n(p.h)} style={`fill: var(--glass-${p.tint})`} />)}
    </g>
    {panes.map((p) => <rect x={n(p.x)} y={n(p.y)} width={n(p.w)} height={n(p.h)} style={`fill: var(--glass-${p.tint}); fill-opacity: ${n(p.alpha * 0.92)}; mix-blend-mode: var(--blend)`} />)}
    {panes.filter((p) => p.h > p.w).map((p) => <rect x={n(p.x + p.w - 0.07)} y={n(p.y)} width="0.07" height={n(p.h)} fill={`url(#${id}-c)`} style="opacity: .7; mix-blend-mode: var(--blend)" />)}
  </svg>
  <span class="line r"></span>
</div>
<style>
  .divider { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: calc(var(--m) * 0.75); position: relative; z-index: 1; margin-block: calc(var(--m) * -1.5); }
  .divider svg { height: auto; display: block; }
  .line { height: 1px; }
  .line.l { background: linear-gradient(90deg, transparent, var(--line-strong)); }
  .line.r { background: linear-gradient(270deg, transparent, var(--line-strong)); }
</style>
