---
import '@fontsource-variable/spline-sans';
import '@fontsource-variable/spline-sans-mono';
import '../styles/site.css';
import sansUrl from '@fontsource-variable/spline-sans/files/spline-sans-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/spline-sans-mono/files/spline-sans-mono-latin-wght-normal.woff2?url';
import Mark from '../components/Mark.astro';
import Wordmark from '../components/Wordmark.astro';
import { springCss } from '../lib/glass';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  nav?: 'home' | 'docs' | 'blog' | 'research' | '';
}
const SITE_DESC = 'fictty is a terminal screen an agent writes as one JSON value, edits live by id, and reads back exactly, while its data streams straight from your commands, never through the model.';
const { title, description = SITE_DESC, type = 'website', published, nav = '' } = Astro.props;
const fullTitle = title ? `${title} · fictty` : 'fictty · Terminal screens agents write, patch and read back';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
const GH = 'https://github.com/brancusi/fictty';
const TUBES = Array.from({ length: 13 }, (_, k) => {
  const d = Math.abs(k - 6) / 6, h = 1.6 + 6 * Math.pow(1 - d, 1.2);
  const tint = k === 6 ? 'amber' : (Math.abs(k - 6) % 2 ? 'violet' : 'cyan');
  return { x: k * 2.6, y: 5 - h / 2, w: 1.05, h, tint };
});
---
<!doctype html>
<html lang="en" style={`--spring: ${springCss()}`}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#f2f3f5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0a0b10" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="fictty blog" href="/blog/rss.xml" />
  <meta property="og:site_name" content="fictty" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? 'fictty: terminal screens agents write, patch and read back'} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The fictty wordmark, letters built from overlapping panes of tinted glass, glowing on a dark ground." />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
  <script is:inline>try{var t=localStorage.getItem('fictty-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="top-in">
      <a class="brand" href="/" aria-label="fictty, home">
        <Mark />
        <Wordmark class="wm" tight id="hdr-wm" glow={false} label="fictty" />
      </a>
      <nav class="nav" aria-label="Site">
        <a href="/docs/" aria-current={nav === 'docs' ? 'page' : undefined}>Docs</a>
        <a href="/research/" aria-current={nav === 'research' ? 'page' : undefined}>Research</a>
        <a href="/blog/" aria-current={nav === 'blog' ? 'page' : undefined}>Blog</a>
        <a href={GH} rel="noopener"><span class="gh-text">GitHub</span><span class="sr-only"> (opens the repository)</span><svg class="gh-icon" viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg></a>
        <button class="theme" type="button" id="themeBtn" aria-label="Theme auto (follows the system). Switch to day.">
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 1.8a6.2 6.2 0 0 1 0 12.4Z" fill="currentColor" class="half"/></svg>
          <span class="label">auto</span>
        </button>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="panes" aria-hidden="true"><span class="line"></span><svg viewBox="-0.5 -0.5 33.3 11">{TUBES.map((t) => <rect x={t.x} y={+t.y.toFixed(2)} width={t.w} height={+t.h.toFixed(2)} style={`fill: var(--glass-${t.tint}); fill-opacity: .72; mix-blend-mode: var(--blend)`} />)}</svg><span class="line"></span></div>
    <span>fictty · MIT · a prototype; the format will change</span>
    <nav aria-label="Footer">
      <a href="/docs/">Docs</a><a href="/architecture/">Architecture</a><a href="/components/">Components</a><a href="/changelog/">Changelog</a><a href="/research/">Research</a><a href="/data-model/">Data model</a><a href="/scope/">Scope</a><a href="/plan/">Plan</a><a href="/adopt-or-build/">Adopt or build</a><a href="/blog/">Blog</a><a href={GH} rel="noopener">GitHub</a><a href="/blog/rss.xml">RSS</a>
    </nav>
  </footer>
  <style>
    .nav a { display: inline-flex; align-items: center; gap: 6px; }
    .gh-icon { width: 15px; height: 15px; }
    @media (min-width: 421px) { .gh-icon { display: none; } }
  </style>
  <script>
    // theme: auto (the system) → day → night → auto, remembered where storage allows
    const order = ['auto', 'light', 'dark'] as const;
    type Mode = (typeof order)[number];
    const names: Record<Mode, string> = { auto: 'auto', light: 'day', dark: 'night' };
    const btn = document.getElementById('themeBtn')!;
    let mode: Mode = 'auto';
    try { const t = localStorage.getItem('fictty-theme'); if (t === 'light' || t === 'dark') mode = t; } catch {}
    function sync() {
      const next = order[(order.indexOf(mode) + 1) % 3];
      btn.querySelector('.label')!.textContent = names[mode];
      btn.setAttribute('aria-label', `Theme ${names[mode]}${mode === 'auto' ? ' (follows the system)' : ''}. Switch to ${next === 'auto' ? 'auto' : names[next]}.`);
      btn.dataset.mode = mode;
    }
    btn.addEventListener('click', () => {
      mode = order[(order.indexOf(mode) + 1) % 3];
      if (mode === 'auto') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = mode;
      try { localStorage.setItem('fictty-theme', mode); } catch {}
      sync();
      dispatchEvent(new Event('fictty:theme'));
    });
    sync();
    // copy buttons
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      b.addEventListener('click', async () => {
        const old = b.textContent;
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'copied'; } catch { b.textContent = 'select it'; }
        setTimeout(() => { b.textContent = old; }, 1400);
      });
    }
  </script>
</body>
</html>
