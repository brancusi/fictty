---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog" description="Notes from building fictty: research, design and what we measured." nav="blog">
  <div class="page">
    <header class="page-head">
      <span class="eyebrow">Blog</span>
      <h1>Notes from building fictty.</h1>
      <p class="lede">Research, design decisions and measurements. The earlier story (the experiment, the landscape, the spin-out) is on the <a href="https://thoughtcontrol.app/blog/fictty/" rel="noopener">Thought Control dev blog</a>.</p>
    </header>
    <ol class="posts">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>
            <span class="meta"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>{p.data.kicker && <span>· {p.data.kicker}</span>}</span>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <span class="more">Read →</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; max-width: 760px; }
  .posts li { border-top: 1px solid var(--line); }
  .posts li:last-child { border-bottom: 1px solid var(--line); }
  .posts a { display: grid; gap: 10px; padding: calc(var(--m) * 1.25) 0; color: inherit; text-decoration: none; }
  .posts .meta { font: 500 12.5px/1.4 var(--mono); color: var(--ink-3); display: flex; gap: 8px; text-transform: none; }
  .posts h2 { font-size: clamp(22px, 2.6vw, 28px); line-height: 1.2; letter-spacing: -0.015em; }
  .posts p { color: var(--ink-2); max-width: 64ch; }
  .posts .more { font: 500 13px/1 var(--mono); color: var(--focus); }
  .posts a:hover h2 { color: var(--focus); }
</style>
