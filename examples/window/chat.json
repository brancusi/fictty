{
 "root": {
  "type": "row",
  "gap": 2,
  "children": [
   {
    "type": "list",
    "id": "rooms",
    "size": 30,
    "title": "MESSAGES",
    "lines": 2,
    "bind": "rooms",
    "item": "<b>{name}</>\t<dim>{when}</>\n<dim>{last}</>"
   },
   {
    "type": "col",
    "gap": 1,
    "children": [
     {
      "type": "text",
      "text": "<heading>Grace Hopper</>  <pos>\u25cf</> <dim>online</>\t<dim>\u2315  \u22ef</>",
      "size": 1
     },
     {
      "type": "rule",
      "size": 1
     },
     {
      "type": "list",
      "id": "thread",
      "bind": "msgs",
      "lines": 2,
      "row_variant": "side",
      "variants": {
       "them": "<dim>{who} \u00b7 {at}</>\n<fg+on-panel> {text} </>",
       "me": "\t<dim>{at}</>\n\t<bg+on-accent> {text} </>"
      }
     },
     {
      "type": "text",
      "text": "<dim>Grace is typing\u2026</>",
      "size": 1
     },
     {
      "type": "row",
      "size": 1,
      "gap": 1,
      "children": [
       {
        "type": "input",
        "id": "compose",
        "placeholder": "Message Grace\u2026",
        "keys": {
         "enter": {
          "do": [
           {
            "append": "msgs",
            "value": {
             "side": "me",
             "who": "You",
             "text": "{store.compose.text}",
             "at": "now"
            }
           },
           {
            "put": "compose",
            "value": ""
           }
          ]
         }
        }
       },
       {
        "type": "button",
        "id": "send",
        "label": "Send",
        "size": 10
       }
      ]
     }
    ]
   }
  ]
 },
