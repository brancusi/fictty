{
 "root": {
  "type": "row",
  "gap": 2,
  "children": [
   {
    "type": "list",
    "id": "rooms",
    "size": 34,
    "title": "MESSAGES",
    "lines": 2,
    "bind": "rooms",
    "item": "<b>{name}</>\t<dim>{when}</>\n<dim>{last}</>"
   },
   {
    "type": "col",
    "gap": 1,
    "children": [
     {
      "type": "row",
      "size": 1,
      "justify": "between",
      "children": [
       {
        "type": "text",
        "text": "<heading>Grace Hopper</>  <pos>\u25cf</> <dim>online</>",
        "size": "fit",
        "wrap": false
       },
       {
        "type": "text",
        "text": "<dim>\u2315  \u22ef</>",
        "size": "fit",
        "wrap": false
       }
      ]
     },
     {
      "type": "rule",
      "size": 1
     },
     {
      "type": "list",
      "id": "thread",
      "bind": "msgs",
      "row": {
       "type": "row",
       "size": "fit",
       "justify": "{$item.side|me=end;*=start}",
       "children": [
        {
         "type": "col",
         "max": 44,
         "margin": [
          0,
          0,
          1,
          0
         ],
         "children": [
          {
           "type": "text",
           "text": "<dim>{$item.who} \u00b7 {$item.at}</>",
           "size": "fit",
           "wrap": false,
           "self": "{$item.side|me=end;*=start}"
          },
          {
           "type": "text",
           "text": "{$item.text}",
           "variant": "{$item.side|me=hero;*=card}",
           "pad": [
            1,
            0
           ],
           "size": "fit",
           "self": "{$item.side|me=end;*=start}"
          }
         ]
        }
       ]
      }
     },
     {
      "type": "text",
      "text": "<dim>Grace is typing\u2026</>",
      "size": 1
     },
     {
      "type": "row",
      "size": 1,
      "gap": 1,
      "children": [
       {
        "type": "input",
        "id": "compose",
        "placeholder": "Message Grace\u2026",
        "keys": {
         "enter": {
          "do": [
           {
            "append": "msgs",
            "value": {
             "side": "me",
             "who": "You",
             "text": "{store.compose.text}",
             "at": "now"
            }
           },
           {
            "put": "compose",
            "value": ""
           }
          ]
         }
        }
       },
       {
        "type": "button",
        "id": "send",
        "label": "Send",
        "size": "fit"
       }
      ]
     }
    ]
   }
  ]
 },
