{
 "root": {
  "type": "col",
  "gap": 1,
  "children": [
   {
    "type": "row",
    "size": 1,
    "justify": "between",
    "children": [
     {
      "type": "text",
      "text": "<heading>Phase 1 \u00b7 the window</>   <dim>8 cards \u00b7 3 people</>",
      "size": "fit",
      "wrap": false
     },
     {
      "type": "text",
      "text": "<dim>+ New card   \u2315 Filter</>",
      "size": "fit",
      "wrap": false
     }
    ]
   },
   {
    "type": "each",
    "id": "board",
    "bind": "cols",
    "row": true,
    "gap": 2,
    "template": {
     "type": "list",
     "id": "col-{$item.id}",
     "title": "{$item.title} \u00b7 {$item.n}",
     "bind": "cards.{$item.id}",
     "row": {
      "type": "col",
      "size": "fit",
      "variant": "card",
      "border": true,
      "pad": [
       1,
       0
      ],
      "margin": [
       0,
       0,
       1,
       0
      ],
      "children": [
       {
        "type": "text",
        "text": "<b>{$item.t}</>",
        "size": "fit"
       },
       {
        "type": "row",
        "size": 1,
        "justify": "between",
        "children": [
         {
          "type": "text",
          "text": "<accent>#{$item.tag}</>",
          "size": "fit",
          "wrap": false
         },
         {
          "type": "text",
          "text": "<dim>{$item.size}</>",
          "size": "fit",
          "wrap": false
         }
        ]
       }
      ]
     },
     "empty": "drop cards here"
    }
   }
  ]
 },
 "store": {
  "cols": [
   {
    "id": "todo",
    "title": "TO DO",
    "n": 3
   },
   {
    "id": "doing",
    "title": "IN PROGRESS",
    "n": 2
   },
   {
    "id": "review",
    "title": "REVIEW",
    "n": 1
   },
   {
    "id": "done",
    "title": "DONE",
    "n": 2
   }
  ],
  "cards": {
   "todo": [
    {
     "id": "todo0",
     "t": "Ellipsis for cut lines",
     "tag": "window",
     "size": "S"
    },
    {
     "id": "todo1",
     "t": "Cards: radius, gradient and a shadow in every theme",
     "tag": "themes",
     "size": "M"
    },
    {
     "id": "todo2",
     "t": "IME composition",
     "tag": "input",
     "size": "S"
    }
   ],
   "doing": [
    {
     "id": "doing0",
     "t": "Parts as styles",
     "tag": "themes",
     "size": "L"
    },
    {
     "id": "doing1",
     "t": "Charts on canvas",
     "tag": "charts",
     "size": "M"
    }
   ],
   "review": [
    {
     "id": "review0",
     "t": "Layout parity",
     "tag": "window",
     "size": "M"
    }
   ],
   "done": [
    {
     "id": "done0",
     "t": "Window under test",
     "tag": "tests",
     "size": "M"
    },
    {
     "id": "done1",
     "t": "Fuzz through the window",
     "tag": "tests",
     "size": "S"
    }
   ]
  }
 }
}
