{
 "root": {
  "type": "stack",
  "id": "app",
  "children": [
   {
    "type": "col",
    "gap": 1,
    "children": [
     {
      "type": "text",
      "size": 1,
      "text": "<accent+b>\u25c6 FICTTY//MAIL</>   <dim>v@nightcity.example</>\t<dim>\u2318K COMMANDS \u00b7 / SEARCH \u00b7 T THEME</>"
     },
     {
      "type": "row",
      "gap": 2,
      "children": [
       {
        "type": "col",
        "size": 24,
        "gap": 1,
        "children": [
         {
          "type": "list",
          "id": "boxes",
          "size": 6,
          "bind": "boxes",
          "item": "{icon}  {name}\t<dim>{n}</>"
         },
         {
          "type": "text",
          "size": 1,
          "text": "<dim>LABELS</>"
         },
         {
          "type": "list",
          "id": "labels",
          "bind": "labels",
          "item": "{name|markup}"
         },
         {
          "type": "button",
          "id": "compose",
          "label": "\u270e  Compose",
          "size": 1,
          "click": {
           "toast": "New draft",
           "tone": "accent"
          }
         }
        ]
       },
       {
        "type": "col",
        "size": "36%",
        "min": 34,
        "max": 56,
        "gap": 1,
        "children": [
         {
          "type": "input",
          "id": "find",
          "size": 1,
          "placeholder": "Search mail"
         },
         {
          "type": "list",
          "id": "inbox",
          "bind": "mail",
          "filter": "find",
          "lines": 2,
          "item": "{unread|true=<accent>\u25cf</> ;*=  }<b>{from}</>\t<dim>{when}</>\n  {subject}",
          "keys": {
           "e": {
            "do": [
             {
              "remove": "mail"
             },
             {
              "toast": "Archived",
              "tone": "pos"
             }
            ]
           }
          }
         }
        ]
       },
       {
        "type": "col",
        "id": "reader",
        "gap": 1,
        "children": [
         {
          "type": "text",
          "id": "msg",
          "bind": "@inbox",
          "pad": [
           1,
           0
          ],
          "text": "<b>{subject}</>\n<dim>{from} \u00b7 {when} \u00b7 #{tag}</>\n\n{body}"
         },
         {
          "type": "editor",
          "id": "reply",
          "title": "REPLY",
          "size": "30%",
          "syntax": "markdown",
          "pad": [
           1,
           0
          ],
          "placeholder": "Write a reply\u2026  (**bold**, - lists, [[links]])"
         },
         {
          "type": "row",
          "size": 1,
          "gap": 1,
          "children": [
           {
            "type": "button",
            "id": "send",
            "label": "Send \u21b5",
            "size": 12,
            "click": {
             "do": [
              {
               "toast": "Sent",
               "tone": "pos"
              }
             ]
            }
           },
           {
            "type": "button",
            "id": "archive",
            "label": "Archive",
            "size": 12,
            "click": {
             "toast": "Archived",
             "tone": "pos"
            }
           },
           {
            "type": "text",
            "text": ""
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "col",
    "id": "palette",
    "modal": true,
    "when": "palette",
    "border": true,
    "pad": [
     1,
     0
    ],
    "gap": 1,
    "float": {
     "width": 64,
     "height": 13,
     "at": "top",
     "margin": 4
    },
    "keys": {
     "esc": {
      "do": [
       {
        "put": "palette",
        "value": false
       },
       {
        "focus": "$prev"
       }
      ]
     }
    },
    "children": [
     {
      "type": "input",
      "id": "cmd",
      "size": 1,
      "placeholder": "Type a command\u2026",
      "keys": {
       "down": {
        "focus": "cmds"
       },
       "enter": {
        "focus": "cmds"
       }
      }
     },
     {
      "type": "list",
      "id": "cmds",
      "bind": "cmds",
      "filter": "cmd",
      "item": "{name}\t<dim>{key}</>",
      "click": {
       "do": [
        {
         "put": "palette",
         "value": false
        },
        {
         "toast": "Ran a command",
         "tone": "accent"
        },
        {
         "focus": "inbox"
        }
       ]
      },
      "keys": {
       "enter": {
        "do": [
         {
          "put": "palette",
          "value": false
         },
         {
          "toast": "Ran a command",
          "tone": "accent"
         },
         {
          "focus": "inbox"
         }
        ]
       }
      }
     }
    ]
   }
  ]
 },
 "store": {
  "mail": [
   {
