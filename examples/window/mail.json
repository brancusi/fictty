    "body": "12 comments, 3 new files, 1 mention."
   }
  ],
  "boxes": [
   {
    "id": "inbox",
    "icon": "\u25c9",
    "name": "Inbox",
    "n": "2"
   },
   {
    "id": "star",
    "icon": "\u2605",
    "name": "Starred",
    "n": ""
   },
   {
    "id": "sent",
    "icon": "\u2197",
    "name": "Sent",
    "n": ""
   },
   {
    "id": "drafts",
    "icon": "\u270e",
    "name": "Drafts",
    "n": "1"
   },
   {
    "id": "arch",
    "icon": "\u25a4",
    "name": "Archive",
    "n": ""
   }
  ],
  "labels": [
   {
    "id": "r",
    "name": "<violet>\u25cf</> research"
   },
   {
    "id": "w",
    "name": "<accent>\u25cf</> work"
   },
   {
    "id": "u",
    "name": "<amber>\u25cf</> updates"
   }
  ],
  "cmds": [
   {
    "id": "c1",
    "name": "Compose",
    "key": "c"
   },
   {
    "id": "c2",
    "name": "Reply",
    "key": "r"
   },
   {
    "id": "c3",
    "name": "Archive",
    "key": "e"
   },
   {
    "id": "c4",
    "name": "Next theme",
    "key": "t"
   },
   {
    "id": "c5",
    "name": "Search mail",
    "key": "/"
   },
   {
    "id": "c6",
    "name": "Mark all read",
    "key": "\u21e7I"
   }
  ],
  "palette": false
 },
 "keys": {
  "d-k": {
   "do": [
    {
     "put": "palette",
     "value": true
    },
    {
     "focus": "cmd"
    }
   ]
  },
  "/": {
   "focus": "find"
  },
  "t": {
   "theme": "next"
  }
 },
 "focus": "inbox"
}