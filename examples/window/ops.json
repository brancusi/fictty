{
 "root": {
  "type": "col",
  "gap": 1,
  "children": [
   {
    "type": "text",
    "size": 1,
    "bind": "stats",
    "text": "<heading+accent>\u25b2 FICTTY//OPS</>   <dim>PROD \u00b7 EU-WEST \u00b7 {clock}</>\t{status|ok=<pos>\u25cf ALL SYSTEMS NOMINAL</>;*=<rose+b>\u25a0 1 INCIDENT OPEN</>}"
   },
   {
    "type": "row",
    "size": 4,
    "gap": 2,
    "children": [
     {
      "type": "text",
      "id": "s1",
      "title": "REQUESTS",
      "bind": "stats",
      "pad": [
       1,
       0
      ],
      "text": "<stat>{rps}</> <dim>req/s</>\n{\u00b1drps}% <dim>vs last hour</>"
     },
     {
      "type": "text",
      "id": "s2",
      "title": "P95 LATENCY",
      "bind": "stats",
      "pad": [
       1,
       0
      ],
      "text": "<stat>{p95}</> <dim>ms</>\n{\u00b1dp95} ms <dim>vs last hour</>"
     },
     {
      "type": "text",
      "id": "s3",
      "title": "ERROR RATE",
      "bind": "stats",
      "pad": [
       1,
       0
      ],
      "text": "<stat>{errs}%</>\n{\u00b1derr} <dim>points</>"
     },
     {
      "type": "text",
      "id": "s4",
      "title": "DEPLOYS TODAY",
      "bind": "stats",
      "pad": [
       1,
       0
      ],
      "text": "<stat>{deploys}</>\n<dim>1 running \u00b7 1 failed</>"
     }
    ]
   },
   {
    "type": "row",
    "gap": 2,
    "children": [
     {
      "type": "tabs",
      "id": "views",
      "tabs": [
       "SERVICES",
       "DEPLOYS",
       "INCIDENT <rose>\u25a0</>"
      ],
      "children": [
       {
        "type": "table",
        "id": "svc",
        "bind": "services",
        "columns": [
         {
          "title": "Service",
          "value": "<b>{name}</>"
         },
         {
          "title": "Status",
          "value": "{status|up=<pos>\u25cf up</>;down=<neg>\u25cf down</>;*=<warn>\u25cf degraded</>}"
         },
         {
          "title": "Region",
          "value": "<dim>{region}</>"
         },
         {
          "title": "p95",
          "value": "{p95}",
          "align": "right"
         },
         {
          "title": "Errors",
          "value": "{\u00b1err}%",
          "align": "right"
         },
         {
          "title": "CPU",
          "value": "{cpu}",
          "align": "right"
         }
        ]
       },
       {
        "type": "list",
        "id": "deploys",
        "bind": "deploys",
        "lines": 2,
        "item": "{state|done=<pos>\u2713</>;running=<accent>\u25d0</>;failed=<neg>\u2715</>}  <b>{svc}</> <dim>{ver}</>\t<dim>{who} \u00b7 {when}</>\n   {msg}"
       },
       {
        "type": "editor",
        "id": "pm",
        "syntax": "markdown",
        "pad": [
         1,
         0
        ],
        "text": "# Notifications outage\n\n**Status:** investigating \u00b7 started 11:02 UTC\n\n## Timeline\n- 11:02 error rate passes 10% on `notifications`\n- 11:04 paged on-call; deploy v1.9.0 suspected\n- 11:09 rollback started\n\n## Next\n- [x] Roll back to v1.8.4\n- [ ] Confirm the queue drained\n- [ ] Write up [[queue client migration]]\n",
        "links": [
         {
          "kind": "wiki"
         }
        ],
        "tasks": "cycle"
       }
      ]
     },
     {
      "type": "col",
      "size": "32%",
      "min": 36,
      "gap": 1,
      "children": [
       {
        "type": "spinner",
        "id": "deploying",
        "size": 1,
        "text": "<accent>Deploying</> api-gateway v2.14.0 \u00b7 {pct}%",
        "bind": "stats"
       },
       {
        "type": "list",
        "id": "log",
        "title": "ACTIVITY",
        "bind": "log",
        "item": "<dim>{t}</>  {msg|markup}"
       },
       {
        "type": "row",
        "size": 1,
        "gap": 1,
        "children": [
         {
          "type": "button",
          "id": "rollback",
          "label": "Roll back",
          "click": {
           "toast": "Rolling back notifications",
           "tone": "warn"
          }
         },
         {
          "type": "button",
          "id": "page",
          "label": "Page on-call",
          "click": {
           "toast": "Paged Grace",
           "tone": "neg"
          }
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 },
