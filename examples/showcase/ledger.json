{
 "root": {
  "type": "col",
  "children": [
   {
    "type": "text",
    "size": 1,
    "pad": [1, 0],
    "bind": "$theme",
    "text": "<c3>●</> <b>fictty</> <d>›</> ledger <d>· October 2026</>\t<d>esc menu · t theme ·</> <accent>{name}</> "
   },
   {
    "type": "row",
    "pad": [1, 0],
    "children": [
     {
      "type": "col",
      "children": [
       {
        "type": "table",
        "id": "ledger",
        "bind": "ledger",
        "title": "Entries",
        "variant": "card",
        "keys": {
         "x": {
          "remove": "ledger"
         }
        },
        "columns": [
         {
          "title": "date",
          "value": "<d>{date}</>",
          "size": 11
         },
         {
          "title": "payee",
          "value": "{payee}"
         },
         {
          "title": "category",
          "value": "<d>{category}</>",
          "size": 13
         },
         {
          "title": "amount",
          "value": "{±amount}",
          "size": 11,
          "align": "right",
          "total": "amount"
         }
        ]
       },
       {
        "type": "row",
        "size": 3,
        "children": [
         {
          "type": "input",
          "id": "f_date",
          "bind": "f_date",
          "title": "Date",
          "size": 14,
          "pad": [1, 0],
          "text": "2026-10-10"
         },
         {
          "type": "input",
          "id": "f_payee",
          "bind": "f_payee",
          "title": "Payee",
          "pad": [1, 0],
          "placeholder": "Who"
         },
         {
          "type": "input",
          "id": "f_cat",
          "bind": "f_cat",
          "title": "Category",
          "size": 16,
          "pad": [1, 0],
          "placeholder": "Groceries"
         },
         {
          "type": "input",
          "id": "f_amount",
          "bind": "f_amount",
          "title": "Amount ⏎",
          "size": 14,
          "pad": [1, 0],
          "placeholder": "-12.50",
          "accept": "number",
          "keys": {
           "enter": {
            "do": [
             {
              "append": "ledger",
              "value": {
               "id": "{$id}",
               "date": "{store.f_date}",
               "payee": "{store.f_payee}",
               "category": "{store.f_cat}",
               "amount": "{store.f_amount}"
              }
             },
             {
              "put": "f_payee",
              "value": ""
             },
             {
              "put": "f_amount",
              "value": ""
             },
             {
              "focus": "f_payee"
             }
            ]
           }
          }
         }
        ]
       }
      ]
     },
     {
      "type": "text",
      "size": 1,
      "text": ""
     },
     {
      "type": "col",
      "size": 46,
      "children": [
       {
        "type": "big",
        "bind": "books",
        "title": "Balance",
        "size": 6,
        "variant": "card",
        "align": "center",
        "text": "{balance}",
        "tone": "accent"
       },
       {
        "type": "text",
        "bind": "books",
        "size": 4,
        "pad": [1, 0],
        "variant": "card",
        "text": "<pos>in</>   <b>{income}</>\t<d>saved</> <b>{saved}</>\n<neg>out</>  <b>{spent}</>\t<d>{entries} entries</>"
       },
       {
        "type": "bars",
        "bind": "books.categories",
        "title": "Spending by category",
        "variant": "card",
        "pad": [1, 0],
        "label": "{name}",
        "value": "amount",
        "horizontal": true,
        "tone": "amber",
        "size": 11
       },
       {
        "type": "chart",
        "title": "Running balance",
        "variant": "card",
        "series": [
         {
          "name": "balance",
          "bind": "books.running",
          "color": "accent"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "text",
    "size": 1,
    "pad": [1, 0],
    "text": "<d>tab moves to the form · enter on the amount books it · x deletes the selected entry · the summary comes from </><accent>books.py</><d>, a helper reading the store</>"
   }
  ]
 },
 "data": {
  "books": {
   "stream": [
    "python3",
    "books.py"
   ]
  }
 },
