{
 "root": {
  "type": "col",
  "children": [
   {
    "type": "row",
    "size": 1,
    "children": [
     {
      "type": "text",
      "text": " <accent+b>fictty</> <d>tour</>",
      "size": 14
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "seen=Saturn"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!seen=Saturn"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "plan.0.children.0.done"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!plan.0.children.0.done"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "items.3"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!items.3"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "trash"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!trash"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "$theme.name!=glass"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!$theme.name!=glass"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "agent_done"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!agent_done"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "open"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!open"
     },
     {
      "type": "text",
      "text": "<accent+b>◆</>",
      "size": 2,
      "when": "big_q"
     },
     {
      "type": "text",
      "text": "<accent+b>◇</>",
      "size": 2,
      "when": "!big_q"
     },
     {
      "type": "text",
      "text": "<d>9/10</>  <b>Speed</> ",
      "align": "right"
     }
    ]
   },
   {
    "type": "text",
    "text": "<border>{*─}</>",
    "size": 1
   },
   {
    "type": "row",
    "children": [
     {
      "type": "col",
      "title": "9 · Speed",
      "size": 44,
      "variant": "card",
      "children": [
       {
        "type": "text",
        "text": "Updates are messages; the screen draws only when something changed, at most 120 times a second, and only the newest value of a busy source is drawn.\n\nThe table on the right is fed by one <b>awk</> process printing JSON lines as fast as it can. The list holds 100,000 rows and filters on every key.",
        "pad": [
         1,
         0
        ]
       },
       {
        "type": "text",
        "text": "\n<accent+b>Try</>\n<d>›</> watch the counters\n<d>›</> <b>tab</> to the filter and type: every word must match\n<d>›</> <b>G</> jumps to the last row",
        "pad": [
         1,
         0
        ],
        "size": 6
       },
       {
        "type": "col",
        "size": 5,
        "edge": "rounded",
        "children": [
         {
          "type": "text",
          "text": "<pos+b>◆ Quest done.</>\n<b>n</> for the next chapter.",
          "when": "big_q",
          "pad": [
           1,
           0
          ]
         },
         {
          "type": "text",
          "text": "<warn+b>◇ Quest</>\nFilter the 100,000 rows.",
          "when": "!big_q",
          "pad": [
           1,
           0
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "row",
      "children": [
       {
        "type": "col",
        "children": [
         {
          "type": "row",
          "size": 5,
          "gap": 1,
          "children": [
           {
            "type": "big",
            "title": "frames a second",
            "text": "{fps}",
            "bind": "$stats",
            "tone": "accent",
            "align": "center",
            "variant": "card"
           },
           {
            "type": "big",
            "title": "messages a second",
            "text": "{msgs}",
            "bind": "$stats",
            "tone": "pos",
            "align": "center",
            "variant": "card"
           },
           {
            "type": "big",
            "title": "ms to draw a frame",
            "text": "{draw_ms}",
            "bind": "$stats",
            "tone": "warn",
            "align": "center",
            "variant": "card"
           }
          ]
         },
         {
          "type": "row",
          "gap": 1,
          "children": [
           {
            "type": "table",
            "id": "book",
            "bind": "fire.rows",
            "title": "a stream, as fast as awk can print",
            "size": "55%",
            "columns": [
             {
              "title": "sym",
              "value": "{sym}",
              "size": 6
             },
             {
              "title": "price",
              "value": "{px}",
              "size": 9,
              "align": "right"
             },
             {
              "title": "‰",
              "value": "{±chg}",
              "size": 7,
              "align": "right",
              "heat": {
               "value": "{chg}",
               "min": -2,
               "max": 2
              }
             }
            ]
           },
           {
            "type": "col",
            "children": [
             {
              "type": "text",
              "text": "seq <b>{seq}</>   index <accent+b>{index}</>",
              "bind": "fire",
              "size": 1,
              "pad": [
               1,
               0
              ]
             },
             {
              "type": "sparkline",
              "bind": "fire.hist",
              "title": "index",
              "tone": "accent"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "type": "col",
        "size": 40,
        "children": [
         {
          "type": "input",
          "id": "big_q",
          "size": 3,
          "title": "filter",
          "placeholder": "filter 100,000 rows: try ada kyoto"
         },
         {
          "type": "list",
          "id": "big",
          "bind": "big",
          "filter": "big_q",
          "title": "100,000 rows",
          "item": "<d>{n}</> {who} <d>in</> {city}\t<d>{likes}</>"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "stack",
    "size": 1,
    "children": [
     {
      "type": "row",
      "children": [
       {
        "type": "text",
        "text": " <b>n</> <d>next</>  <b>p</> <d>back</>  <b>tab</> <d>move</>  <b>esc</> <d>leaves a field</>  <b>t</> <d>theme</>  <b>a</> <d>apps</>  <b>q</> <d>quit</>"
       },
       {
        "type": "text",
        "text": "<d>{fps} fps · {msgs} msg/s · {draw_ms} ms a frame</> ",
        "bind": "$stats",
        "align": "right",
        "size": 44
       }
      ]
     },
     {
      "type": "toasts"
     }
    ]
   }
  ]
 },
