{
  "root": {"type": "col", "children": [
    {"type": "text", "size": 1, "pad": [1, 0], "bind": "$theme",
     "text": "<c1>●</> <b>fictty</> <d>›</> agent <d>· what agents did over the socket, and what the store holds</>\t<d>t theme ·</> <accent>{name}</> <d>· esc menu</> "},
    {"type": "row", "pad": [1, 0], "children": [
      {"type": "list", "id": "activity", "bind": "$log", "title": "Agent activity, newest first", "variant": "card",
       "item": "<d>{at}</>  {op|push=<accent+b>push   </>;patch=<violet+b>patch  </>;put=<pos+b>put    </>;edit=<amber+b>edit   </>;merge=<amber+b>merge  </>;set=<violet+b>set    </>;key=<b>key    </>;theme=<violet+b>theme  </>;refused=<rose+b>refused</>;*=<b>$</>}  {what}",
       "empty": "Nothing yet. Run examples/showcase/tour.sh in another terminal and watch an agent drive this showcase."},
      {"type": "text", "size": 1, "text": ""},
      {"type": "col", "size": "46%", "children": [
        {"type": "table", "id": "entries", "bind": "$store", "title": "The store", "variant": "card",
         "columns": [
           {"title": "entry", "value": "<b>{key}</>"},
           {"title": "rev", "value": "{rev}", "size": 5, "align": "right"},
           {"title": "by", "value": "{by|person=<accent>person</>;seed=<d>seed</>;*=<amber>$</>}", "size": 8},
           {"title": "holds", "value": "<d>{holds}</>", "size": 17}
         ]},
        {"type": "list", "id": "try", "title": "Try it from another terminal: click to copy", "variant": "quiet", "size": 7,
         "item": " <accent>{cmd}</>\t<d>{about}</>  <b>⧉</> ",
         "mark": "▌", "lead": " ",
         "items": [
           {"cmd": "tour.sh", "about": "an agent drives this showcase"},
           {"cmd": "fictty read note/standup", "about": "read a note"},
           {"cmd": "echo '\"hi\"' | fictty put draft -", "about": "write the new-note field"},
           {"cmd": "fictty theme paper", "about": "change the theme"},
           {"cmd": "fictty get --state", "about": "everything, as JSON"}
         ],
         "click": {"do": [{"copy": "{$self.env} && {cmd}"}, {"put": "copied", "value": {"cmd": "{cmd}"}}]},
         "keys": {"enter": {"do": [{"copy": "{$self.env} && {cmd}"}, {"put": "copied", "value": {"cmd": "{cmd}"}}]}}},
        {"type": "text", "bind": "copied", "size": 1, "pad": [2, 0],
         "text": "<pos+b>✓ copied</> <d>· paste it in another terminal ·</> {cmd}"},
        {"type": "text", "size": 4, "pad": [2, 0],
         "text": "<d>Each line sets that terminal up for this screen first, so plain <b>fictty</> works there after.\nWrites take <b>--if-rev N</>: if anyone wrote since revision N, the write is refused.</>"}
      ]}
    ]},
    {"type": "text", "size": 1, "pad": [1, 0],
     "text": "<d>The store outlives every screen: the notes, the ledger and your drafts are all here, by revision and by who wrote them last.</>"}
  ]},
  "keys": {"esc": {"load": "home.json"}, "t": {"theme": "next"}},
  "status_bar": false
}
