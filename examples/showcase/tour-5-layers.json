{
 "root": {
  "type": "col",
  "children": [
   {
    "type": "row",
    "size": 1,
    "children": [
     {
      "type": "text",
      "text": " <accent+b>fictty</> <d>tour</>",
      "size": 14
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "seen=Saturn"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!seen=Saturn"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "plan.0.children.0.done"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!plan.0.children.0.done"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "items.3"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!items.3"
     },
     {
      "type": "text",
      "text": "<accent+b>◆</>",
      "size": 2,
      "when": "trash"
     },
     {
      "type": "text",
      "text": "<accent+b>◇</>",
      "size": 2,
      "when": "!trash"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "$theme.name!=glass"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!$theme.name!=glass"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "agent_done"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!agent_done"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "open"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!open"
     },
     {
      "type": "text",
      "text": "<pos>◆</>",
      "size": 2,
      "when": "big_q"
     },
     {
      "type": "text",
      "text": "<d>◇</>",
      "size": 2,
      "when": "!big_q"
     },
     {
      "type": "text",
      "text": "<d>5/10</>  <b>Layers</> ",
      "align": "right"
     }
    ]
   },
   {
    "type": "text",
    "text": "<border>{*─}</>",
    "size": 1
   },
   {
    "type": "row",
    "children": [
     {
      "type": "col",
      "title": "5 · Layers",
      "size": 44,
      "variant": "card",
      "children": [
       {
        "type": "text",
        "text": "A <b>stack</> draws its children over each other. One that <b>float</>s sits where it says; a <b>modal</> one dims what's behind it and keeps the focus. With <b>when</>, a layer comes and goes with the store.\n\nToasts, callouts and rings are layers too: agents use them to point at things.",
        "pad": [
         1,
         0
        ]
       },
       {
        "type": "text",
        "text": "\n<accent+b>Try</>\n<d>›</> <b>d</> on a file opens the dialog\n<d>›</> <b>tab</> between its buttons, <b>esc</> backs out\n<d>›</> resize the window",
        "pad": [
         1,
         0
        ],
        "size": 6
       },
       {
        "type": "col",
        "size": 5,
        "edge": "rounded",
        "children": [
         {
          "type": "text",
          "text": "<pos+b>◆ Quest done.</>\n<b>n</> for the next chapter.",
          "when": "trash",
          "pad": [
           1,
           0
          ]
         },
         {
          "type": "text",
          "text": "<warn+b>◇ Quest</>\nDelete a file, and say yes.",
          "when": "!trash",
          "pad": [
           1,
           0
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "row",
      "children": [
       {
        "type": "stack",
        "children": [
         {
          "type": "row",
          "gap": 1,
          "children": [
           {
            "type": "list",
            "id": "files",
            "bind": "files",
            "title": "files · d deletes",
            "item": "{name}",
            "keys": {
             "d": {
              "do": [
               {
                "put": "doomed",
                "value": "{name}"
               },
               {
                "put": "confirm",
                "value": true
               }
              ]
             }
            }
           },
           {
            "type": "list",
            "id": "trash",
            "bind": "trash",
            "title": "trash",
            "size": "30%",
            "item": "<d>{name}</>",
            "empty": "Nothing deleted yet."
           },
           {
            "type": "text",
            "title": "only when wide",
            "size": 30,
            "when": "$screen.width>=150",
            "pad": [
             1,
             0
            ],
            "text": "This pane shows only while your terminal is at least 150 columns wide:\n\n<accent>\"when\": \"$screen.width>=150\"</>\n\nMake the window narrower and watch it go."
           }
          ]
         },
         {
          "type": "col",
          "id": "ask",
          "title": "Delete?",
          "modal": true,
          "when": "confirm",
          "variant": "alert",
          "float": {
           "width": 44,
           "height": 8
          },
          "pad": [
           2,
           1
          ],
          "keys": {
           "esc": {
            "put": "confirm",
            "value": false
           }
          },
          "children": [
           {
            "type": "text",
            "text": "Delete <b>{.}</> for good?",
            "bind": "doomed",
            "size": 2
           },
           {
            "type": "row",
            "size": 1,
            "gap": 2,
            "children": [
             {
              "type": "button",
              "id": "yes",
              "label": "Delete",
              "click": {
               "do": [
                {
                 "append": "trash",
                 "value": {
                  "name": "{store.doomed}"
                 }
                },
                {
                 "remove": "files",
                 "where": {
                  "name": "{store.doomed}"
                 }
                },
                {
                 "put": "confirm",
                 "value": false
                },
                {
                 "toast": "Deleted {store.doomed}",
                 "tone": "neg"
                }
               ]
              }
             },
             {
              "type": "button",
              "id": "no",
              "label": "Keep it",
              "click": {
               "do": [
                {
                 "put": "confirm",
                 "value": false
                },
                {
                 "toast": "Kept it"
                }
               ]
              }
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "stack",
    "size": 1,
    "children": [
     {
      "type": "row",
      "children": [
       {
        "type": "text",
        "text": " <b>n</> <d>next</>  <b>p</> <d>back</>  <b>tab</> <d>move</>  <b>esc</> <d>leaves a field</>  <b>t</> <d>theme</>  <b>a</> <d>apps</>  <b>q</> <d>quit</>"
       },
       {
        "type": "text",
        "text": "<d>{fps} fps · {msgs} msg/s · {draw_ms} ms a frame</> ",
        "bind": "$stats",
        "align": "right",
        "size": 44
       }
      ]
     },
     {
      "type": "toasts"
     }
    ]
   }
  ]
 },
 "keys": {
