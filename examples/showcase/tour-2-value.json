        "readonly": true,
        "text": "{\n \"type\": \"row\",\n \"children\": [\n  {\n   \"type\": \"list\",\n   \"id\": \"planets\",\n   \"title\": \"Planets\",\n   \"size\": \"40%\",\n   \"items\": [\n    {\n     \"name\": \"Mercury\",\n     \"au\": 0.39,\n     \"moons\": 0,\n     \"ring\": false\n    },\n    {\n     \"name\": \"Venus\",\n     \"au\": 0.72,\n     \"moons\": 0,\n     \"ring\": false\n    },\n    {\n     \"name\": \"Earth\",\n     \"au\": 1.0,\n     \"moons\": 1,\n     \"ring\": false\n    },\n    {\n     \"name\": \"Mars\",\n     \"au\": 1.52,\n     \"moons\": 2,\n     \"ring\": false\n    },\n    {\n     \"name\": \"Jupiter\",\n     \"au\": 5.2,\n     \"moons\": 95,\n     \"ring\": true\n    },\n    {\n     \"name\": \"Saturn\",\n     \"au\": 9.58,\n     \"moons\": 146,\n     \"ring\": true\n    },\n    {\n     \"name\": \"Uranus\",\n     \"au\": 19.2,\n     \"moons\": 28,\n     \"ring\": true\n    },\n    {\n     \"name\": \"Neptune\",\n     \"au\": 30.1,\n     \"moons\": 16,\n     \"ring\": true\n    }\n   ],\n   \"item\": \"{name}\\t<d>{moons} moons</>\",\n   \"keys\": {\n    \"enter\": {\n     \"do\": [\n      {\n       \"put\": \"seen\",\n       \"value\": \"{name}\"\n      },\n      {\n       \"toast\": \"You picked {name}\",\n       \"tone\": \"pos\"\n      }\n     ]\n    }\n   }\n  },\n  {\n   \"type\": \"text\",\n   \"bind\": \"@planets\",\n   \"title\": \"Detail\",\n   \"pad\": [\n    1,\n    0\n   ],\n   \"text\": \"<b>{name}</>\\n\\n{au} AU from the sun\\n{moons} moons\\n{ring|true=<accent>rings</>;*=<d>no rings</>}\"\n  }\n ]\n}"
