   {
    "type": "row",
    "children": [
     {
      "type": "col",
      "title": "2 · One value",
      "size": 44,
      "variant": "card",
      "children": [
       {
        "type": "text",
        "text": "A fictty screen is a <b>value</>: a tree of nodes, the data they show and the keys they take. The little app on the right is the JSON beside it, nothing more.\n\nAn agent builds one the way it writes any JSON, pushes it into a running screen (<accent>fictty push ui.json</>), and reads back exactly what it shows (<accent>fictty screen</>, <accent>fictty get --state</>).",
        "pad": [
         1,
         0
        ]
       },
       {
        "type": "text",
        "text": "\n<accent+b>Try</>\n<d>›</> <b>j</>/<b>k</> or the mouse to move\n<d>›</> <b>tab</> into the JSON, scroll it\n<d>›</> the detail follows the selection (<accent>\"bind\": \"@planets\"</>)",
        "pad": [
         1,
         0
        ],
        "size": 6
       },
       {
        "type": "col",
        "size": 5,
        "edge": "rounded",
        "children": [
         {
          "type": "text",
          "text": "<pos+b>◆ Quest done.</>\n<b>n</> for the next chapter.",
          "when": "seen=Saturn",
          "pad": [
           1,
           0
          ]
         },
         {
          "type": "text",
          "text": "<warn+b>◇ Quest</>\nSelect <b>Saturn</> and press <b>Enter</>.",
          "when": "!seen=Saturn",
          "pad": [
           1,
           0
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "row",
