             0
            ],
            "text": "variant <b>alert</>"
           }
          ]
         },
         {
          "type": "text",
          "text": "<accent>● accent</>  <pos>● pos</>  <neg>● neg</>  <warn>● warn</>  <violet>● violet</>  <dim>● dim</>",
          "size": 1,
          "pad": [
           1,
           0
          ]
         },
         {
          "type": "row",
          "gap": 1,
          "children": [
           {
            "type": "table",
            "title": "a table",
            "items": [
             {
              "k": "rev",
              "v": "12"
             },
             {
              "k": "by",
              "v": "agent"
             },
             {
