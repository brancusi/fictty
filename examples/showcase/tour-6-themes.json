      "text": "<d>6/9</>  <b>Themes</> ",
      "align": "right"
     }
    ]
   },
   {
    "type": "text",
    "text": "<border>{*─}</>",
    "size": 1
   },
   {
    "type": "row",
    "children": [
     {
      "type": "col",
      "title": "6 · Themes",
      "size": 44,
      "variant": "card",
      "children": [
       {
        "type": "text",
        "text": "Screens ask for <b>meanings</>, never colours: a <b>variant</> (card, quiet, alert) and a <b>tone</> (pos, neg, warn). A theme says what those look like.\n\nSo one key restyles everything, every screen, at once, and an agent never picks a colour.",
        "pad": [
         1,
         0
        ]
       },
       {
        "type": "text",
        "text": "\n<accent+b>Try</>\n<d>›</> <b>t</> cycles glass, paper and phosphor\n<d>›</> the theme stays when you change chapter",
        "pad": [
         1,
         0
        ],
        "size": 5
       },
       {
        "type": "col",
        "size": 5,
        "edge": "rounded",
        "children": [
         {
          "type": "text",
          "text": "<pos+b>◆ Quest done.</>\n<b>n</> for the next chapter.",
          "when": "$theme.name!=glass",
          "pad": [
           1,
           0
          ]
         },
         {
          "type": "text",
          "text": "<warn+b>◇ Quest</>\nPress <b>t</> to change the theme.",
          "when": "!$theme.name!=glass",
          "pad": [
           1,
           0
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "row",
      "children": [
       {
        "type": "col",
        "gap": 1,
        "children": [
         {
          "type": "text",
          "text": "Now: <accent+b>{name}</>   <d>of {names}</>",
          "bind": "$theme",
          "size": 1,
          "pad": [
           1,
           0
          ]
         },
         {
          "type": "row",
          "size": 4,
          "gap": 1,
          "children": [
           {
            "type": "text",
            "variant": "card",
            "title": "card",
            "pad": [
             1,
             0
            ],
            "text": "variant <b>card</>"
           },
           {
            "type": "text",
            "variant": "quiet",
            "title": "quiet",
            "pad": [
             1,
             0
            ],
            "text": "variant <b>quiet</>"
           },
