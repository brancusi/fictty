{
 "root": {
  "type": "col",
  "children": [
   {
    "type": "text",
    "size": 1,
    "pad": 1,
    "bind": "ticks",
    "text": "<c2>●</> <b>fictty</> <d>›</> markets <d>· a made-up market, live from</> <accent>ticks.py</>\t<d>{clock} · esc menu · t theme</> "
   },
   {
    "type": "row",
    "pad": 1,
    "children": [
     {
      "type": "col",
      "size": "55%",
      "children": [
       {
        "type": "table",
        "id": "watch",
        "bind": "ticks.tickers",
        "title": "Watchlist",
        "variant": "card",
        "columns": [
         {
          "title": "symbol",
          "value": "<b>{sym}</>",
          "size": 8
         },
         {
          "title": "name",
          "value": "<d>{name}</>"
         },
         {
          "title": "price",
          "value": "{price}",
          "size": 10,
          "align": "right"
         },
         {
          "title": "today",
          "value": "{pct}%",
          "size": 9,
          "align": "right",
          "heat": {
           "value": "{pct}",
           "min": -5,
           "max": 5
          }
         }
        ],
        "size": 12
       },
       {
        "type": "row",
        "size": "*",
        "children": [
         {
          "type": "bars",
          "bind": "ticks.tickers",
          "title": "Volume, millions",
          "variant": "card",
          "label": "{sym}",
          "value": "vol",
          "tone": "violet"
         },
         {
          "type": "col",
          "size": 26,
          "children": [
           {
            "type": "gauge",
            "bind": "ticks.breadth",
            "title": "Breadth",
            "variant": "card",
            "size": 3,
            "value": "{ratio}",
            "label": "{up} up · {down} down",
            "tone": "accent"
           },
           {
            "type": "text",
            "bind": "ticks.index",
            "title": "Index",
            "variant": "card",
            "pad": 1,
            "text": "<b>{value}</>\t{±pct}%"
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "text",
      "size": 1,
      "text": ""
     },
     {
      "type": "col",
      "children": [
       {
        "type": "text",
        "bind": "@watch",
        "title": "Detail",
        "variant": "card",
        "size": 7,
        "pad": [
         2,
         1
        ],
        "text": "<accent+b>{sym}</>  <b>{name}</>\t{±pct}%\n\n<d>last</>  <b>{price}</>   <d>change</> {chg}   <d>range</> {lo} – {hi}"
       },
       {
        "type": "chart",
        "title": "Price, last 90 ticks",
        "variant": "card",
        "series": [
         {
          "name": "price",
          "bind": "@watch.history",
          "color": "accent"
         }
        ]
       },
       {
        "type": "chart",
        "title": "Index",
        "variant": "card",
        "size": 10,
        "series": [
         {
          "name": "index",
          "bind": "ticks.index.series",
          "color": "violet"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "text",
    "size": 1,
    "pad": 1,
    "text": "<d>j / k move · the detail and its chart follow the selected row · every number here comes from a stream source, four lines a second</>"
   }
  ]
 },
 "data": {
  "ticks": {
   "stream": [
    "python3",
    "ticks.py"
   ]
  }
 },
 "keys": {
  "esc": {
   "load": "home.json"
  },
  "t": {
   "theme": "next"
  }
 },
 "status_bar": false
}